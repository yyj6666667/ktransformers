# Absolute host path. The model is mounted read-only and is never downloaded.
MODEL_DIR=/mnt/data/models/DeepSeek-V4-Flash

# CUDA-visible GPU IDs. The legacy variable name is retained, but it accepts a
# comma-separated list for tensor parallelism, for example GPU_DEVICE=0,1.
GPU_DEVICE=0
PORT=30000
# Tensor-parallel degree. It must not exceed the number of selected GPU_DEVICEs.
TP=1
CONTEXT_LENGTH=16384
MEM_FRACTION=0.90
KT_GPU_EXPERTS=0
KT_GPU_PREFILL_TOKEN_THRESHOLD=2048
CHUNKED_PREFILL_SIZE=4096
MAX_PREFILL_TOKENS=4096
# Leave empty for automatic sizing. The layerwise slot capacity is retained
# from KV-cache profiling without passing --max-total-tokens.
MAX_TOTAL_TOKENS=
# The default ratio keeps enough SWA KV pages for a 4096-token prefill chunk.
SWA_FULL_TOKENS_RATIO=0.4
ENABLE_MTP=0

# Leave these unset for automatic kernel selection. Maintainers can force AVX2
# during an image validation run with KT_KERNEL_CPU_VARIANT=avx2 and
# KT_MXFP4_BACKEND=avx2.
KT_KERNEL_CPU_VARIANT=
KT_MXFP4_BACKEND=
KT_KERNEL_DEBUG=0

# Leave empty for hardware auto-detection.
KT_CPUINFER_THREADS=
KT_THREADPOOL_COUNT=
